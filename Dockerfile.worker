# syntax=docker/dockerfile:1
################################################################
# aeolus-worker — pg-boss consumer running Tectonic + Typst.
# A queue consumer: no port, no HTTP surface, no health endpoint. Whatever
# runs it just keeps the process alive.
# Built from the repo root: `docker build -f Dockerfile.worker .`
################################################################
# Base images are pinned by digest (resolved 2026-09-13 from Docker Hub's
# manifest list; the tag beside the digest is documentation). Tectonic and
# Typst are pinned by sha256 too.

FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS deps
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /repo

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY tsconfig.base.json turbo.json ./
COPY apps/compile-worker/package.json apps/compile-worker/
COPY packages/db/package.json packages/db/
COPY packages/crdt/package.json packages/crdt/
COPY packages/auth/package.json packages/auth/
COPY packages/shared/package.json packages/shared/

RUN --mount=type=cache,id=pnpm-store,target=/pnpm-store \
    pnpm config set store-dir /pnpm-store && \
    pnpm install --frozen-lockfile \
        --filter @aeolus/compile-worker... \
        --prod

COPY packages/ packages/
COPY apps/compile-worker/ apps/compile-worker/

################################################################
# ---- aeolus-sandbox: the Landlock confinement helper for the compile engine ----
# Compiled in its own stage so gcc/headers stay out of the runtime image.
# ABI is negotiated at RUNTIME (see aeolus-sandbox.c), so building against
# bookworm's kernel headers is fine regardless of the Fargate host kernel.
# Node binary source for the runtime stage (see the COPY below).
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS node-src

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS sandbox-build
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc libc6-dev linux-libc-dev \
    && rm -rf /var/lib/apt/lists/*
COPY apps/compile-worker/native/aeolus-sandbox.c /src/aeolus-sandbox.c
RUN gcc -O2 -Wall -Wextra -Werror -o /usr/local/bin/aeolus-sandbox /src/aeolus-sandbox.c

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS runtime

ARG TECTONIC_VERSION=0.15.0
ARG TYPST_VERSION=0.12.0
ARG TECTONIC_SHA256=dfb82876f2986862996e564fa507a9e576e0c1e3bee63c2c1bd677c2543e6407
ARG TYPST_SHA256=605130a770ebd59a4a579673079cb913a13e75985231657a71d6239a57539ec3

ENV DEBIAN_FRONTEND=noninteractive \
    TECTONIC_CACHE_DIR=/opt/tectonic-cache \
    NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl xz-utils tini coreutils fontconfig \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    curl -fsSL -o /tmp/tectonic.tar.gz \
        "https://github.com/tectonic-typesetting/tectonic/releases/download/tectonic%40${TECTONIC_VERSION}/tectonic-${TECTONIC_VERSION}-x86_64-unknown-linux-musl.tar.gz"; \
    echo "${TECTONIC_SHA256}  /tmp/tectonic.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/tectonic.tar.gz -C /tmp; \
    install -m 0755 /tmp/tectonic /usr/local/bin/tectonic; \
    rm -rf /tmp/tectonic /tmp/tectonic.tar.gz

RUN set -eux; \
    curl -fsSL -o /tmp/typst.tar.xz \
        "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz"; \
    echo "${TYPST_SHA256}  /tmp/typst.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/typst.tar.xz -C /tmp; \
    install -m 0755 /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst; \
    rm -rf /tmp/typst-x86_64-unknown-linux-musl /tmp/typst.tar.xz

# The Landlock sandbox helper that confines the engine (ADR 0022).
COPY --from=sandbox-build /usr/local/bin/aeolus-sandbox /usr/local/bin/aeolus-sandbox

# Landlock confinement for the TeX engines, in audit mode by default: it logs
# what it would have blocked and blocks nothing. `enforce` is the right setting
# and the README says so, but it fails closed — on a kernel without Landlock,
# or under a container runtime whose seccomp profile hides it, enforce turns
# every compile into a failure. Audit lets a new install work, and its boot
# line tells the operator whether enforce would.
ENV AEOLUS_SANDBOX_MODE=audit

# Node comes from the same digest-pinned node image the other two
# processes run on, copied in — not from `curl … | bash` against
# nodesource, which was an unpinned, unverified script executed as root
# in the one image that runs untrusted documents. The debian base stays:
# the Landlock helper and tectonic's fontconfig need it.
COPY --from=node-src /usr/local/bin/node /usr/local/bin/node
COPY --from=node-src /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
    && node --version

# No database CA bundle is baked in. A managed Postgres reached over a network
# should be given one: mount your provider's root bundle into the container and
# set AEOLUS_DB_CA_FILE to it, with AEOLUS_DB_SSL=verify. The bundled compose
# stack keeps Postgres on a private network and sets AEOLUS_DB_SSL=disable.

RUN useradd --system --create-home --home-dir /home/compiler --shell /usr/sbin/nologin compiler \
    && mkdir -p /tmp/compile /opt/tectonic-cache /app \
    && chown -R compiler:compiler /tmp/compile /opt/tectonic-cache /app

# Pre-warm the Tectonic package cache so the first real compile works
# offline. The warmup doc exercises every package the brand template
# is likely to pull (graphicx, hyperref, xcolor, booktabs, geometry,
# fancyhdr, enumitem, titlesec, listings, fontspec, amsthm, amssymb,
# csquotes) so a doc using them lands no fetches on first compile.
# To add more packages to the warm cache, see
# docs/RUNBOOKS/add-latex-package.md.
#
# Run the warmup as the `compiler` user with the same XDG_CACHE_HOME
# the runtime container will see, so cache files are written under
# the path tectonic 0.15 actually probes at runtime
# (Tectonic splits cache between TECTONIC_CACHE_DIR and
# $XDG_CACHE_HOME/Tectonic depending on bundle file vs format file).
# Previously this ran as root with XDG_CACHE_HOME unset and a
# trailing chown, which left some entries under root-owned paths
# the runtime user couldn't extend — defeating the warmup on the
# first prod compile.
ENV XDG_CACHE_HOME=/opt/tectonic-cache
RUN set -eux; \
    WARMDIR="$(mktemp -d)"; \
    chown -R compiler:compiler "$WARMDIR" /opt/tectonic-cache; \
    printf '%s\n' \
        '\documentclass[11pt,a4paper]{article}' \
        '\usepackage[utf8]{inputenc}' \
        '\usepackage[T1]{fontenc}' \
        '\usepackage[margin=1in]{geometry}' \
        '\usepackage{graphicx}' \
        '\usepackage{xcolor}' \
        '\usepackage[colorlinks=true,linkcolor=blue,urlcolor=blue]{hyperref}' \
        '\usepackage{booktabs}' \
        '\usepackage{fancyhdr}' \
        '\usepackage{enumitem}' \
        '\usepackage{titlesec}' \
        '\usepackage{listings}' \
        '\usepackage{amsmath}' \
        '\usepackage{amssymb}' \
        '\usepackage{amsthm}' \
        '\usepackage{csquotes}' \
        '\pagestyle{fancy}' \
        '\fancyhf{}' \
        '\fancyhead[L]{Warmup}' \
        '\fancyfoot[C]{\thepage}' \
        '\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}' \
        '\setlist[itemize]{leftmargin=*}' \
        '\definecolor{accent}{HTML}{f7a559}' \
        '\newtheorem{thm}{Theorem}' \
        '\lstset{basicstyle=\ttfamily\small,breaklines=true}' \
        '\begin{document}' \
        '\section{Warmup}' \
        'Hello, \emph{\textcolor{accent}{world}}! $a^2 + b^2 = c^2$' \
        '\begin{itemize} \item one \item two \end{itemize}' \
        '\begin{thm} For any $x$, $x = x$. \end{thm}' \
        '\enquote{quoted text}' \
        '\begin{lstlisting}' \
        'print("hi")' \
        '\end{lstlisting}' \
        '\begin{tabular}{lr} \toprule a & 1 \\\\ \midrule b & 2 \\\\ \bottomrule \end{tabular}' \
        '\href{https://example.com}{link}' \
        '\end{document}' \
        > "$WARMDIR/warmup.tex"; \
    chown compiler:compiler "$WARMDIR/warmup.tex"; \
    su -s /bin/sh compiler -c "cd $WARMDIR && \
      TECTONIC_CACHE_DIR=/opt/tectonic-cache \
      XDG_CACHE_HOME=/opt/tectonic-cache \
      tectonic -X compile --outfmt pdf warmup.tex >/dev/null"; \
    rm -rf "$WARMDIR"

WORKDIR /app
COPY --from=deps --chown=compiler:compiler /repo /app

USER compiler
ENV PATH="/app/node_modules/.bin:/usr/local/bin:/usr/bin:/bin"

WORKDIR /app/apps/compile-worker
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["tsx", "src/bin/worker.ts"]
