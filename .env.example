# Aeolus configuration. Copy to .env and edit:
#
#     cp .env.example .env
#
# docker-compose.yml reads this file. Everything has a working default except
# AEOLUS_COOKIE_SECRET, which has none on purpose — the stack refuses to start
# without one rather than shipping a value everybody's install would share.
#
# Generate it:
#
#     openssl rand -base64 48
#
# Every setting below is read by the application, not just by compose; the
# defaults shown are the application's own.


# ── Required ─────────────────────────────────────────────────────────────────

# Signs the session cookie. Anyone who knows it can mint a session for any
# account, so treat it exactly as you would a private key. Changing it signs
# everybody out, which is also how you revoke every session at once.
AEOLUS_COOKIE_SECRET=

# The URL people type. It is used for links the app generates, and as the
# Origin the websocket process accepts editing connections from — so a wrong
# value here does not break sign-in, it breaks editing, quietly.
AEOLUS_PUBLIC_BASE_URL=http://localhost:8080


# ── First launch ─────────────────────────────────────────────────────────────

# With no accounts at all, the api creates this one and prints a generated
# passphrase to the log, once:
#
#     docker compose logs api | grep -A4 "First launch"
#
# Sign in with it and the app immediately asks you to choose your own. After
# that this setting does nothing.
AEOLUS_BOOTSTRAP_ADMIN_EMAIL=admin@localhost


# ── Where it listens ─────────────────────────────────────────────────────────

# The port on your machine. Change it if 8080 is taken.
AEOLUS_PORT=8080

# What Caddy serves. `:8080` is plain http on that port — right for a laptop.
# For a real hostname, put it here (aeolus.example.com), publish 80 and 443 in
# docker-compose.yml, and Caddy gets and renews a certificate by itself. Then
# set AEOLUS_COOKIE_SECURE=1 below.
AEOLUS_SITE_ADDRESS=:8080

# Marks the session cookie Secure, so browsers never send it over plain http.
# Off by default because an install reached over http would otherwise be unable
# to sign anybody in, with no clue as to why. Turn it on the moment you have
# https, which for most people is the moment they set a real hostname above.
AEOLUS_COOKIE_SECURE=0


# ── Database ─────────────────────────────────────────────────────────────────

# The password for the bundled Postgres. It never leaves the compose network —
# the database publishes no port — but change it anyway if this install is
# shared, and change it before the first `up`, because it is only read when the
# data volume is created.
POSTGRES_PASSWORD=aeolus

# Only if you point DATABASE_URL at a database of your own:
#
#   disable   no TLS. What the bundled Postgres uses.
#   require   TLS, certificate not checked. Stops a passive listener, not an
#             active one.
#   verify    TLS, chain checked against AEOLUS_DB_CA_FILE. The right answer
#             for a managed database reached across a network.
#
# Unset, the app guesses from the hostname, and refuses to guess in production.
# AEOLUS_DB_SSL=verify
# AEOLUS_DB_CA_FILE=/etc/ssl/certs/your-provider-ca.pem


# ── Object storage ───────────────────────────────────────────────────────────

# Document snapshots and uploaded assets. The bundled MinIO serves this; point
# it at real S3 by setting AWS_S3_ENDPOINT empty, AWS_REGION to your region,
# and the key pair below to an AWS credential.
#
# This is not optional. With no bucket each process keeps its own snapshots in
# its own memory, cannot see the others', and documents read back truncated.
AEOLUS_S3_BUCKET=aeolus
AWS_REGION=us-east-1

# MinIO's credentials. Also handed to the AWS SDK as its key pair, which it
# needs even against MinIO: with no credentials at all the SDK goes looking for
# EC2 instance metadata and hangs for a minute before failing.
MINIO_ROOT_USER=aeolus
MINIO_ROOT_PASSWORD=aeolus-dev-secret


# ── Compiling ────────────────────────────────────────────────────────────────

# Landlock confinement for Tectonic and Typst. A TeX document can read any file
# the process can — `\input{/etc/passwd}` is a valid document — and this is what
# stops it.
#
#   audit     logs what it would have blocked, blocks nothing. The default,
#             because it cannot break anything.
#   enforce   actually blocks, and fails closed: on a kernel or container
#             runtime without Landlock, every compile fails.
#
# Turn it to enforce. First check the worker's boot line, which says whether
# this host can:
#
#     docker compose logs worker | grep sandbox
#
# `landlock enforcing (ABI vN)` means enforce will work. `landlock UNAVAILABLE`
# means it will refuse every compile.
AEOLUS_SANDBOX_MODE=audit

# Tectonic downloads its TeX bundle from the internet on first use. To pin a
# version, or to run with no outbound network at all, host a bundle yourself
# and name it here.
# AEOLUS_TECTONIC_BUNDLE=https://example.com/tectonic/bundle.tar


# ── Optional ─────────────────────────────────────────────────────────────────

# The AI writing assistant. Without a key the feature is simply absent — no
# errors, no half-working panel.
# ANTHROPIC_API_KEY=

# A spend ceiling for it, in cents per day, across the whole instance.
# AEOLUS_AI_DAILY_CAP_CENTS=500

# Outbound mail, for notifications. Unset, mail is captured in memory and
# nothing is sent, which is the right default for an install with no mail
# server. Set it to a verified sender address to use AWS SES.
# AEOLUS_MAIL_FROM=aeolus@example.com

# Who may put Aeolus in an iframe, as CSP source expressions. Default: nobody
# but Aeolus itself. Widening this lets the listed origins frame the editor on
# a page you do not control, so list only sites you run.
# AEOLUS_FRAME_ANCESTORS='self' https://intranet.example.com

# Whose X-Forwarded-For header to believe. The compose stack sets
# `uniquelocal`, which trusts the reverse proxy on its private network. Behind
# a proxy of your own, name its address or network. `true` believes anybody,
# and is only safe if the app cannot be reached except through the proxy —
# otherwise a caller writes whatever client address they like and the sign-in
# rate limit counts a fiction.
# AEOLUS_TRUST_PROXY=uniquelocal

# Set only if the websocket process is on a different origin from the api.
# Empty means the same origin at /ws, which is what the compose stack serves.
# AEOLUS_WS_URL=wss://ws.example.com

# Send the session cookie to every subdomain rather than just this host. Needed
# only if you split api and ws across two hostnames; set it to the shared
# parent. Get this wrong and the editor connects but saves nothing.
# AEOLUS_COOKIE_DOMAIN=example.com

# Log level for the websocket process. The api takes its own default.
# AEOLUS_LOG_LEVEL=info
