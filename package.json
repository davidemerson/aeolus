{
  "name": "aeolus",
  "version": "0.0.0",
  "private": true,
  "description": "Collaborative LaTeX/Typst editor — monorepo root",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && eslint scripts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @aeolus/tests-e2e run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:refs": "node scripts/check-no-private-refs.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:brand": "node scripts/build-brand-assets.mjs --check",
    "brand": "node scripts/build-brand-assets.mjs",
    "build:electron:linux": "pnpm --filter @aeolus/electron run build:linux",
    "build:electron:mac": "pnpm --filter @aeolus/electron run build:mac",
    "build:electron:win": "pnpm --filter @aeolus/electron run build:win"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "testcontainers": "^11.14.0",
    "turbo": "^2.11.7",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "unrs-resolver"
    ],
    "overrides": {
      "@babel/core": ">=7.29.6",
      "@grpc/grpc-js": ">=1.14.4",
      "@humanfs/node": ">=0.16.8",
      "@tootallnate/once": ">=3.0.1",
      "@xmldom/xmldom": "^0.8.15",
      "baseline-browser-mapping": ">=2.11.0",
      "brace-expansion": ">=5.0.9",
      "browserslist": ">=4.28.7",
      "builder-util-runtime": ">=9.7.0",
      "fast-uri": "^3.1.6",
      "fast-xml-builder": ">=1.1.7",
      "fast-xml-parser": ">=5.7.0",
      "find-my-way": ">=9.7.0",
      "form-data": ">=4.0.6",
      "ip-address": ">=10.3.1",
      "js-yaml": ">=4.3.1",
      "nanoid": ">=3.3.12",
      "postcss": ">=8.5.23",
      "postcss-selector-parser": ">=6.1.3",
      "protobufjs": ">=8.6.6",
      "shell-quote": ">=1.9.0",
      "tar": ">=7.5.21",
      "tmp": ">=0.2.6",
      "undici": "^7.29.0",
      "uuid": ">=14.0.0",
      "ws@^6.0.0": ">=6.2.4",
      "ws@^8.0.0": ">=8.21.3"
    }
  },
  "license": "AGPL-3.0-only"
}
